# =============================================================================
# mietminderung.online — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Variables marked [REQUIRED] must be set for the feature to work.
# Variables marked [OPTIONAL] have sensible defaults or graceful fallbacks.
# =============================================================================

# --- Canonical site URL (SEO) -------------------------------------------------
# Drives canonical tags, sitemap.xml, robots.txt and JSON-LD. Must be the exact
# origin the site is served from in production, without a trailing slash — a
# mismatch makes Google index the wrong host. Leave unset on preview
# deployments so they inherit the production canonical.
NEXT_PUBLIC_SITE_URL=     # [OPTIONAL] default: https://mietminderung.online

# --- Email delivery (Resend) -------------------------------------------------
# Used by /api/send-email to send the Mängelanzeige via email.
RESEND_API_KEY=           # [REQUIRED] Your Resend API key (https://resend.com)
RESEND_FROM_EMAIL=        # [OPTIONAL] Sender address (default: noreply@mietminderung.online)

# --- Postal delivery (eBrief.de) ---------------------------------------------
# Used by /api/send-letter to send the Mängelanzeige as a physical letter.
EBRIEF_USERNAME=          # [REQUIRED] eBrief account username
EBRIEF_PASSWORD=          # [REQUIRED] eBrief account password
EBRIEF_API_URL=           # [OPTIONAL] API base URL (default: https://api.ebrief.de)

# --- AI text enhancement (Anthropic Claude) -----------------------------------
# Used by /api/enhance-beschreibung to improve user-written defect descriptions.
ANTHROPIC_API_KEY=        # [OPTIONAL] Anthropic API key — falls back to original text if unset

# --- Newsletter / email signup (Google Sheets) --------------------------------
# Used by /api/save-email to store newsletter signups.
GOOGLE_SHEET_WEBHOOK_URL= # [OPTIONAL] Google Apps Script webhook URL
