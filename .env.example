# =============================================================================
# mietminderung.online — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Variables marked [REQUIRED] must be set for the feature to work.
# Variables marked [OPTIONAL] have sensible defaults or graceful fallbacks.
# =============================================================================

# --- Canonical site URL (SEO + dispatch) --------------------------------------
# Drives canonical tags, sitemap.xml, robots.txt and JSON-LD. Must be the exact
# origin the site is served from in production, without a trailing slash — a
# mismatch makes Google index the wrong host. Leave unset on preview
# deployments so they inherit the production canonical.
#
# Dispatch depends on it too: /api/versand/checkout builds the Stripe return
# URLs from it and puts it into the payment session's idempotency key. It must
# not fall back to the request's Host header there, because that is chosen by
# the caller — a forged Host would send the payer off-domain after paying and
# would open a second payment session for a letter already paid for. Unset
# outside production the route falls back to the request origin; unset in
# production it refuses to run at all. Being a NEXT_PUBLIC_ variable, a value
# present at build time is inlined into the bundle and a later runtime change
# has no effect until the next build — so set it for the build.
NEXT_PUBLIC_SITE_URL=     # [OPTIONAL for SEO — REQUIRED for dispatch in production]

# --- AI text enhancement (Google Gemini Flash) --------------------------------
# Used by /api/enhance-beschreibung to translate and formalise the defect
# descriptions the tenant typed. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=           # [OPTIONAL] Falls back to the user's original text if unset
GEMINI_MODEL=             # [OPTIONAL] Model id (default: gemini-2.5-flash)

# --- Postal dispatch (eBrief) -------------------------------------------------
# Sends the finished Mängelanzeige as a physical letter. Credentials come from
# eBrief support after account setup. Without these the dispatch option is
# hidden and the site stays download-only.
EBRIEF_BASE_URL=          # [OPTIONAL] default: https://api.staging.ebrief.de
EBRIEF_USER=              # [REQUIRED for dispatch] Basic-auth user
EBRIEF_PASSWORD=          # [REQUIRED for dispatch] Basic-auth password

# Signs the capability token that /api/versand/vorbereiten hands back with the
# jobId. GET /api/versand/status and /api/versand/adressvorschau are
# unauthenticated and eBrief's job ids are small sequential integers, so the
# token is the only thing keeping the finished letters — tenant name, both
# addresses, defect description, signature — from being read by counting
# upwards. Any long random string, e.g. `openssl rand -hex 32`. Unset, dispatch
# refuses to start at all rather than running without the protection.
VERSAND_TOKEN_SECRET=     # [REQUIRED for dispatch] Random secret, min. 32 chars

# --- Payment (Stripe) ---------------------------------------------------------
# Charges the dispatch fee. The webhook secret is what makes the dispatch
# trigger trustworthy — without it no letter is ever sent. The return URLs the
# payer lands on come from NEXT_PUBLIC_SITE_URL above, which is therefore
# required in production.
STRIPE_SECRET_KEY=        # [REQUIRED for dispatch]
STRIPE_WEBHOOK_SECRET=    # [REQUIRED for dispatch]

# Tax mode. The operator is a small business under § 19 UStG, so no VAT may be
# stated anywhere. Switch to "regel" only after leaving that status.
STEUERMODUS=              # [OPTIONAL] kleinunternehmer (default) | regel

# --- Cron ---------------------------------------------------------------------
# Protects /api/cron/ebrief-cleanup, which deletes unpaid jobs after 24h.
CRON_SECRET=              # [REQUIRED for dispatch]

# --- Newsletter / email signup (Google Sheets) --------------------------------
# Used by /api/save-email to store newsletter signups.
GOOGLE_SHEET_WEBHOOK_URL= # [OPTIONAL] Google Apps Script webhook URL
