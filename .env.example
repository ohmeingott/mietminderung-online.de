# =============================================================================
# mietminderung.online — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Variables marked [REQUIRED] must be set for the feature to work.
# Variables marked [OPTIONAL] have sensible defaults or graceful fallbacks.
# =============================================================================

# --- AI text enhancement (Google Gemini Flash) --------------------------------
# Used by /api/enhance-beschreibung to translate and formalise the defect
# descriptions the tenant typed. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=           # [OPTIONAL] Falls back to the user's original text if unset
GEMINI_MODEL=             # [OPTIONAL] Model id (default: gemini-2.5-flash)

# --- Postal delivery (eBrief.de) ---------------------------------------------
# Used by /api/send-letter to send the Mängelanzeige as a physical letter.
# The paid postal option is HIDDEN in the UI unless the feature flag below is
# switched on. Do not enable it before a payment flow and the Widerrufsbelehrung
# for paid services are in place — see LAUNCH_CHECKLIST.md.
NEXT_PUBLIC_ENABLE_POST_VERSAND=  # [OPTIONAL] "true" shows the paid postal option (default: hidden)
EBRIEF_USERNAME=          # [REQUIRED if postal dispatch is enabled] eBrief account username
EBRIEF_PASSWORD=          # [REQUIRED if postal dispatch is enabled] eBrief account password
EBRIEF_API_URL=           # [OPTIONAL] API base URL (default: https://api.ebrief.de)

# --- Newsletter / email signup (Google Sheets) --------------------------------
# Used by /api/save-email to store newsletter signups.
GOOGLE_SHEET_WEBHOOK_URL= # [OPTIONAL] Google Apps Script webhook URL
