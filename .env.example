# =============================================================================
# mietminderung.online — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Variables marked [REQUIRED] must be set for the feature to work.
# Variables marked [OPTIONAL] have sensible defaults or graceful fallbacks.
# =============================================================================

# --- Canonical site URL (SEO) -------------------------------------------------
# Drives canonical tags, sitemap.xml, robots.txt and JSON-LD. Must be the exact
# origin the site is served from in production, without a trailing slash — a
# mismatch makes Google index the wrong host. Leave unset on preview
# deployments so they inherit the production canonical.
NEXT_PUBLIC_SITE_URL=     # [OPTIONAL] default: https://mietminderung.online

# --- AI text enhancement (Google Gemini Flash) --------------------------------
# Used by /api/enhance-beschreibung to translate and formalise the defect
# descriptions the tenant typed. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=           # [OPTIONAL] Falls back to the user's original text if unset
GEMINI_MODEL=             # [OPTIONAL] Model id (default: gemini-2.5-flash)

# The site is download-only and completely free — there is no paid service and
# therefore no payment or postal-dispatch configuration.

# --- Case storage & reminder emails (opt-in) ----------------------------------
# The calculator and letter generator work with NONE of these set — the opt-in
# card then shows its error state and everything else keeps working.
#
# DATABASE_URL: Neon Postgres connection string. Provision via the Vercel
# dashboard (Storage → Neon, region Frankfurt); the integration sets it
# automatically. Apply db/migrations/0001_cases.sql in the Neon SQL editor.
DATABASE_URL=             # [REQUIRED for case storage] postgres://... (EU region)
RESEND_API_KEY=           # [REQUIRED for case storage] https://resend.com API key
EMAIL_FROM=               # [OPTIONAL] Sender (default: Mietminderung Online <erinnerung@mietminderung.online>)
CASE_TOKEN_SECRET=        # [REQUIRED for case storage] 32+ random chars; signs the manage links in emails
CRON_SECRET=              # [REQUIRED for case storage] 32+ random chars; Vercel sends it as Bearer token to /api/cron
RATE_LIMIT_SALT=          # [REQUIRED for case storage] random; salts the transient IP hashes for rate limiting
